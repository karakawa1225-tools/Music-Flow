{
  "name": "music-flow",
  "version": "2.0.0",
  "description": "MUSIC FLOW — Your Music. Your Library. Your Flow.",
  "main": "./out/main/index.js",
  "author": "MUSIC FLOW",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "migrate:turso": "tsx scripts/migrate-turso.mjs",
    "dev:api": "tsx src/server/index.ts",
    "dev:web": "concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"vite --config vite.config.web.ts\"",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.config.web.ts --port 4174",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "hono": "^4.13.4",
    "jose": "^6.2.10",
    "lucide-react": "^0.474.0",
    "music-metadata": "^10.6.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
