{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "installCommand": "npm install --ignore-scripts",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/[[...route]].ts": {
      "maxDuration": 60,
      "includeFiles": "turso/**"
    }
  },
  "regions": ["hnd1"]
}
